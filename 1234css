
/* =========================
   1. GLOBAL STYLES
========================= */

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  scroll-behavior: smooth;
}

:root {
  --primary: #12b963;
  --primary-dark: #078c47;
  --light-green: #e0f9e6;
  --pale-green: #f1fff4;
  --text: #17251d;
  --muted: #69766d;
  --border: #edf0ed;
  --white: #ffffff;
}

body {
  font-family: Arial, Helvetica, sans-serif;
  color: var(--text);
  background: var(--white);
  line-height: 1.6;
}

a {
  text-decoration: none;
  color: inherit;
}

button {
  cursor: pointer;
  border: none;
  font-family: inherit;
  font-size: 14px;
}

img {
  max-width: 100%;
}

.container {
  width: min(1120px, 90%);
  margin: 0 auto;
}

.eyebrow {
  color: #139b57;
  font-size: 12px;
  font-weight: bold;
  letter-spacing: 2px;
  margin-bottom: 15px;
}

.btn,
.nav-btn {
  display: inline-block;
  background: var(--primary);
  color: white;
  padding: 12px 20px;
  border-radius: 6px;
  transition: background 0.25s, transform 0.25s;
}

.btn:hover,
.nav-btn:hover {
  background: var(--primary-dark);
  transform: translateY(-2px);
}

/* =========================
   2. HEADER & NAVIGATION
========================= */

header {
  background: var(--pale-green);
  padding: 22px 0;
}

.navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
}

.logo {
  color: #139b57;
  font-size: 23px;
  font-weight: 800;
  white-space: nowrap;
}

.logo span {
  font-size: 13px;
}

nav {
  display: flex;
  align-items: center;
  gap: 25px;
  font-size: 14px;
}

nav a {
  transition: color 0.2s;
}

nav a:hover {
  color: var(--primary);
}

/* =========================
   3. HERO SECTION
========================= */

.hero {
  background: var(--light-green);
  padding: 75px 0 55px;
}

.hero-content {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  align-items: center;
  gap: 45px;
}

.hero h1 {
  font-size: clamp(36px, 5vw, 55px);
  line-height: 1.12;
  letter-spacing: -1.5px;
  margin-bottom: 20px;
}

.hero p {
  color: #53665a;
  max-width: 480px;
  margin-bottom: 25px;
}

.hero-image {
  background: #b6edc6;
  border-radius: 24px;
  min-height: 320px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.hero-image img {
  width: 100%;
  height: 100%;
  min-height: 320px;
  object-fit: cover;
}

.image-placeholder {
  font-size: 100px;
}

/* =========================
   4. CLIENT LOGOS
========================= */

.clients {
  padding: 25px 0;
  text-align: center;
  border-bottom: 1px solid var(--border);
}

.clients p {
  color: #777;
  font-size: 12px;
  margin-bottom: 18px;
}

.client-logos {
  display: flex;
  justify-content: space-around;
  align-items: center;
  flex-wrap: wrap;
  gap: 18px;
  color: #66746a;
  font-size: 18px;
  font-weight: bold;
}

/* =========================
   5. SECTION TITLES
========================= */

.section {
  padding: 75px 0;
}

.section-title {
  max-width: 520px;
  margin-bottom: 35px;
}

.section-title h2 {
  font-size: clamp(28px, 4vw, 36px);
  line-height: 1.2;
  margin: 10px 0 15px;
}

.section-title p {
  color: var(--muted);
}

/* =========================
   6. SERVICES
========================= */

.services {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 25px;
}

.service-card {
  padding: 25px;
  border: 1px solid var(--border);
  border-radius: 12px;
  transition: transform 0.25s, box-shadow 0.25s;
}

.service-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 10px 30px #0000000c;
}

.service-icon {
  width: 48px;
  height: 48px;
  display: grid;
  place-items: center;
  background: var(--light-green);
  border-radius: 10px;
  font-size: 24px;
  margin-bottom: 20px;
}

.service-card h3 {
  font-size: 19px;
  margin-bottom: 10px;
}

.service-card p {
  color: var(--muted);
  font-size: 14px;
  margin-bottom: 18px;
}

.learn {
  color: #159653;
  font-size: 14px;
  font-weight: bold;
}

/* =========================
   7. STATISTICS
========================= */

.stats {
  background: var(--pale-green);
  padding: 35px 20px;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
  border-radius: 15px;
  text-align: center;
}

.stat-item strong {
  display: block;
  color: #119d53;
  font-size: 30px;
}

.stat-item span {
  color: #66746a;
  font-size: 13px;
}

/* =========================
   8. PORTFOLIO
========================= */

.projects {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 30px;
}

.project-card {
  border: 1px solid var(--border);
  border-radius: 12px;
  overflow: hidden;
  transition: box-shadow 0.25s;
}

.project-card:hover {
  box-shadow: 0 10px 30px #0000000c;
}

.project-visual {
  min-height: 220px;
  display: grid;
  place-items: center;
  padding: 25px;
  background: #dff8e7;
}

.project-visual.purple {
  background: #eeebff;
}

.project-visual.orange {
  background: #fff0df;
}

.project-visual.blue {
  background: #e4f3ff;
}

.mockup {
  width: 100%;
  max-width: 350px;
  background: white;
  border-radius: 10px;
  padding: 18px;
  box-shadow: 0 8px 25px #0000000c;
}

.mockup-top {
  width: 65%;
  height: 9px;
  background: #c9f0d5;
  border-radius: 5px;
  margin-bottom: 15px;
}

.mockup-line {
  width: 85%;
  height: 7px;
  background: #e8eee9;
  border-radius: 5px;
  margin: 9px 0;
}

.mockup-boxes {
  display: flex;
  gap: 10px;
  margin-top: 15px;
}

.mockup-boxes span {
  flex: 1;
  height: 65px;
  background: #e1f8e8;
  border-radius: 6px;
}

.project-info {
  padding: 22px;
}

.project-info h3 {
  margin-bottom: 8px;
}

.project-info p {
  color: var(--muted);
  font-size: 14px;
}

/* =========================
   9. TESTIMONIALS
========================= */

.testimonials {
  background: #f8fbf8;
}

.reviews {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}

.review {
  background: white;
  border: 1px solid var(--border);
  padding: 24px;
  border-radius: 12px;
}

.stars {
  color: #f2a900;
  margin-bottom: 15px;
}

.review p {
  color: #59675e;
  font-size: 14px;
  margin-bottom: 20px;
}

.reviewer {
  font-size: 14px;
  font-weight: bold;
}

.reviewer small {
  display: block;
  color: #879087;
  font-weight: normal;
}

/* =========================
   10. NEWSLETTER
========================= */

.newsletter {
  text-align: center;
  padding: 75px 20px;
}

.newsletter h2 {
  font-size: 32px;
  margin: 10px 0;
}

.newsletter p {
  color: var(--muted);
  margin-bottom: 22px;
}

.newsletter form {
  display: flex;
  gap: 10px;
  max-width: 470px;
  margin: auto;
}

.newsletter input {
  flex: 1;
  min-width: 0;
  padding: 13px;
  border: 1px solid #dce5dd;
  border-radius: 6px;
  font-size: 14px;
}

/* =========================
   11. CONTACT
========================= */

#contact {
  text-align: center;
}

#contact h2 {
  font-size: 32px;
  margin-bottom: 15px;
}

#contact p {
  color: var(--muted);
  margin-bottom: 25px;
}

/* =========================
   12. FOOTER
========================= */

footer {
  background: #08c66b;
  color: #063d25;
  padding: 45px 0 20px;
}

.footer-grid {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1fr;
  gap: 35px;
  margin-bottom: 35px;
}

.footer-brand h2 {
  font-size: 24px;
  margin-bottom: 12px;
}

.footer-brand p {
  max-width: 300px;
  font-size: 14px;
}

.footer-column h3 {
  font-size: 15px;
  margin-bottom: 12px;
}

.footer-column a {
  display: block;
  font-size: 14px;
  margin: 7px 0;
}

.footer-column a:hover {
  text-decoration: underline;
}

.copyright {
  border-top: 1px solid #ffffff55;
  padding-top: 18px;
  font-size: 12px;
}

.copyright p {
  margin-bottom: 8px;
}

/* =========================
   13. TABLETS & PHONES
========================= */

@media (max-width: 760px) {
  .navbar {
    flex-wrap: wrap;
  }

  nav {
    order: 3;
    width: 100%;
    justify-content: center;
    flex-wrap: wrap;
    gap: 14px;
    font-size: 12px;
  }

  .nav-btn {
    padding: 9px 12px;
    font-size: 12px;
  }

  .hero {
    padding: 45px 0;
  }

  .hero-content {
    grid-template-columns: 1fr;
    gap: 30px;
  }

  .hero-image,
  .hero-image img {
    min-height: 230px;
  }

  .section {
    padding: 50px 0;
  }

  .services {
    grid-template-columns: 1fr;
  }

  .stats {
    grid-template-columns: repeat(2, 1fr);
  }

  .projects {
    grid-template-columns: 1fr;
  }

  .reviews {
    grid-template-columns: 1fr;
  }

  .footer-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .newsletter h2 {
    font-size: 26px;
  }
}

/* SMALL PHONES */

@media (max-width: 380px) {
  .footer-grid {
    grid-template-columns: 1fr;
  }

  .newsletter form {
    flex-direction: column;
  }

  .hero h1 {
    font-size: 34px;
  }
}
